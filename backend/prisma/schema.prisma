datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS EXISTENTES ---
enum EventStatus {
  pending
  approved
  rejected
  finished
  cancelled
}

enum TicketStatus {
  active
  sold_out
  paused
  hidden
  expired
}

enum OrderStatus {
  pending
  processing
  paid
  cancelled
  refunded
  failed
}

enum DiscountType {
  PERCENTAGE
  FIXED
  PERCENTAGE_FEE
}

// --- NOVOS ENUMS FINANCEIROS ---
enum IssuedTicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

enum LedgerTransactionType {
  SALE
  REFUND
  CHARGEBACK
  PAYOUT
  ADJUSTMENT
}

// --- MODELOS PRINCIPAIS (AGENDA CULTURAL) ---

model SystemConfig {
  id            String   @id @default(uuid())
  platformFee   Int      @default(1000) // 1000 = 10.00%
  minFee        Int      @default(200) // 200 = R$ 2,00
  premiumPrice  Int      @default(10000) // 10000 = R$ 100,00
  standardPrice Int      @default(200) // 200 = R$ 2,00
  updatedAt     DateTime @updatedAt

  @@map("system_config")
}

model User {
  id                       String    @id @default(uuid())
  name                     String
  email                    String    @unique
  password                 String?
  isAdmin                  Boolean   @default(false)
  stripeAccountId          String? // Mantido temporariamente por segurança
  stripeOnboardingComplete Boolean   @default(false)
  profilePicture           String?
  coverPicture             String?
  bio                      String?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relações essenciais mantidas
  eventsOrganized Event[] @relation("EventOrganizer")
  favoritedEvents Event[] @relation("UserFavorites")

  @@map("users")
}

model Event {
  id              String      @id @default(uuid())
  title           String
  description     String
  imageUrl        String
  city            String
  location        String
  category        String
  ageRating       String?
  status          EventStatus @default(pending)
  externalUrl     String?
  isInformational Boolean     @default(true) // Agora por padrão é informativo

  // Destaque (Agenda Patrocinada)
  isFeatured          Boolean @default(false)
  isFeaturedRequested Boolean @default(false)
  highlightStatus     String  @default("none")

  // Campos antigos mantidos para não quebrar dados, mas ignorados no front
  priceFrom            Int? // Alterado para Int (Centavos)
  refundPolicy         String    @default("N/A")
  termsAndConditions   String?
  highlightFee         Int       @default(0) // Alterado para Int (Centavos)
  highlightTier        String?
  highlightPaymentLink String?
  highlightDuration    Int?
  highlightExpiresAt   DateTime?
  sessions             Json?
  formSchema           Json?
  organizerInfo        Json?

  // Datas Essenciais
  eventDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações Essenciais
  organizerId String
  organizer   User   @relation("EventOrganizer", fields: [organizerId], references: [id])
  favoritedBy User[] @relation("UserFavorites")

  @@map("events")
}

// --- TABELAS LEGADAS (MANTIDAS APENAS PARA HISTÓRICO DE 3-6 MESES) ---
// NÃO UTILIZAR NO FRONTEND OU BACKEND. SERÃO DELETADAS FUTURAMENTE VIA CRON JOB.

model Partner {
  id          String   @id @default(uuid())
  name        String
  description String?
  instagram   String?
  createdAt   DateTime @default(now())

  @@map("partners")
}

model TicketType {
  id           String       @id @default(uuid())
  eventId      String
  name         String       @default("Ingresso")
  description  String?
  price        Int // Alterado para Int (Centavos)
  quantity     Int
  sold         Int          @default(0)
  batchName    String?
  salesStart   DateTime?
  salesEnd     DateTime?
  activityDate DateTime?
  startTime    String?
  endTime      String?
  isHalfPrice  Boolean      @default(false)
  category     String?
  maxPerUser   Int          @default(4)
  minPerUser   Int          @default(1)
  status       TicketStatus @default(active)

  @@map("ticket_types")
}

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  description       String?
  discountType      DiscountType // Alterado para utilizar o Enum
  discountValue     Int // Alterado para Int (5000 = 50%, ou 1000 = R$10)
  partner           String? // Opcional
  maxUses           Int?
  usedCount         Int          @default(0)
  usageLimitPerUser Int          @default(1)
  minPurchaseAmount Int? // Alterado para Int (Centavos)
  validFrom         DateTime?
  validUntil        DateTime?
  isActive          Boolean      @default(true)
  expiresAt         DateTime?
  eventId           String?
  partnerId         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  usages CouponUsage[] // Relação para travar usos duplicados

  @@map("coupons")
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  eventId         String
  couponId        String?
  subtotal        Int // Alterado para Int (Centavos)
  discountAmount  Int         @default(0) // Alterado para Int (Centavos)
  platformFee     Int // Alterado para Int (Centavos)
  totalAmount     Int // Alterado para Int (Centavos)
  status          OrderStatus @default(pending)
  paymentIntentId String?
  paymentMethod   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String @id @default(uuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id])
  ticketTypeId String
  quantity     Int
  unitPrice    Int // Alterado para Int (Centavos)

  @@map("order_items")
}

model Ticket {
  id              String             @id @default(uuid())
  ticketTypeId    String
  eventId         String
  userId          String
  orderId         String
  qrCodeData      String             @unique
  price           Int // Alterado para Int (Centavos)
  status          IssuedTicketStatus @default(VALID) // Utilizando o novo Enum
  participantData Json?
  usedAt          DateTime?
  createdAt       DateTime           @default(now())

  @@map("tickets")
}

// ==========================================
// --- ESTRUTURA FINANCEIRA E DE SEGURANÇA ---
// ==========================================

model TicketReservation {
  id           String   @id @default(uuid())
  userId       String
  eventId      String
  ticketTypeId String
  quantity     Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("ticket_reservations")
}

model CouponUsage {
  id        String   @id @default(uuid())
  userId    String
  couponId  String
  orderId   String   @unique
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@unique([userId, couponId]) // Trava absoluta no BD: 1 cupom por usuário
  @@map("coupon_usages")
}

model FinancialLedger {
  id          String                @id @default(uuid())
  organizerId String
  eventId     String
  orderId     String?
  type        LedgerTransactionType
  amount      Int // Positivo (Vendas), Negativo (Reembolsos/Repasses)
  description String?
  createdAt   DateTime              @default(now())

  @@map("financial_ledger")
}

// =====================================================================
// --- NOVOS MODELOS: MÚSICA AO VIVO (PROGRAMAÇÃO DE ESTABELECIMENTOS) ---
// =====================================================================

model Artist {
  id        String     @id @default(uuid())
  name      String
  genre     String?
  imageUrl  String?
  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("artists")
}

model Place {
  id        String     @id @default(uuid())
  name      String
  address   String?
  imageUrl  String?
  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("places")
}

model Schedule {
  id       String  @id @default(uuid())
  artistId String
  placeId  String
  title    String? // <-- ADICIONE ESTA LINHA AQUI

  date String
  time String

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  place  Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, placeId, date, time])
  @@map("schedules")
}
