datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---
enum EventStatus {
  pending
  approved
  rejected
  finished
  cancelled
}

enum TicketStatus {
  active
  sold_out
  paused
  hidden
  expired
}

enum OrderStatus {
  pending
  processing
  paid
  cancelled
  refunded
  failed
}

enum DiscountType {
  PERCENTAGE
  FIXED
  PERCENTAGE_FEE
}

// --- MODELOS PRINCIPAIS (AGENDA CULTURAL) ---

model SystemConfig {
  id            String   @id @default(uuid())
  platformFee   Float    @default(0.08)
  minFee        Float    @default(2.00)
  premiumPrice  Float    @default(100.00)
  standardPrice Float    @default(2.00)
  updatedAt     DateTime @updatedAt

  @@map("system_config")
}

model User {
  id                       String    @id @default(uuid())
  name                     String
  email                    String    @unique
  password                 String?
  isAdmin                  Boolean   @default(false)
  stripeAccountId          String?   // Mantido temporariamente por segurança
  stripeOnboardingComplete Boolean   @default(false)
  profilePicture           String?
  coverPicture             String?
  bio                      String?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relações essenciais mantidas
  eventsOrganized          Event[]   @relation("EventOrganizer")
  favoritedEvents          Event[]   @relation("UserFavorites")

  @@map("users")
}

model Event {
  id                   String      @id @default(uuid())
  title                String
  description          String
  imageUrl             String
  city                 String
  location             String
  category             String
  ageRating            String?
  status               EventStatus @default(pending)
  externalUrl          String? 
  isInformational      Boolean     @default(true) // Agora por padrão é informativo
  
  // Destaque (Agenda Patrocinada)
  isFeatured           Boolean     @default(false)
  isFeaturedRequested  Boolean     @default(false)
  highlightStatus      String      @default("none")
  
  // Campos antigos mantidos para não quebrar dados, mas ignorados no front
  priceFrom            Float?  
  refundPolicy         String      @default("N/A")
  termsAndConditions   String?
  highlightFee         Float       @default(0)
  highlightTier        String?
  highlightPaymentLink String?
  highlightDuration    Int?
  highlightExpiresAt   DateTime?
  sessions             Json?
  formSchema           Json?
  organizerInfo        Json?
  
  // Datas Essenciais
  eventDate            DateTime
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // Relações Essenciais
  organizerId          String
  organizer            User        @relation("EventOrganizer", fields: [organizerId], references: [id])
  favoritedBy          User[]      @relation("UserFavorites")
  
  @@map("events")
}


// --- TABELAS LEGADAS (MANTIDAS APENAS PARA HISTÓRICO DE 3-6 MESES) ---
// NÃO UTILIZAR NO FRONTEND OU BACKEND. SERÃO DELETADAS FUTURAMENTE VIA CRON JOB.

model Partner {
  id          String   @id @default(uuid())
  name        String
  description String?
  instagram   String?
  createdAt   DateTime @default(now())
  @@map("partners")
}

model TicketType {
  id           String       @id @default(uuid())
  eventId      String
  name         String       @default("Ingresso")
  description  String?
  price        Float
  quantity     Int
  sold         Int          @default(0)
  batchName    String?
  salesStart   DateTime?
  salesEnd     DateTime?
  activityDate DateTime?
  startTime    String?
  endTime      String?
  isHalfPrice  Boolean      @default(false)
  category     String?
  maxPerUser   Int          @default(4)
  minPerUser   Int          @default(1)
  status       TicketStatus @default(active)
  @@map("ticket_types")
}

model Coupon {
  id                String   @id @default(uuid())
  code              String   @unique
  description       String?
  discountType      String
  discountValue     Float
  partner           String
  maxUses           Int?
  usedCount         Int      @default(0)
  usageLimitPerUser Int      @default(1)
  minPurchaseAmount Float?
  validFrom         DateTime?
  validUntil        DateTime?
  isActive          Boolean  @default(true)
  expiresAt         DateTime?
  eventId           String?
  partnerId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@map("coupons")
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  eventId         String
  couponId        String?
  subtotal        Float
  discountAmount  Float       @default(0)
  platformFee     Float
  totalAmount     Float
  status          OrderStatus @default(pending)
  paymentIntentId String?
  paymentMethod   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Float
  @@map("order_items")
}

model Ticket {
  id              String     @id @default(uuid())
  ticketTypeId    String
  eventId         String
  userId          String
  orderId         String
  qrCodeData      String     @unique
  price           Float
  status          String     @default("valid")
  participantData Json?
  usedAt          DateTime?
  createdAt       DateTime   @default(now())
  @@map("tickets")
}